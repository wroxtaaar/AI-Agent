# Free cloud AI through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Remote agent API authentication
AGENT_API_TOKEN=replace-with-a-long-random-token
AGENT_HOST=0.0.0.0
AGENT_PORT=8787

# Colon-separated VPS roots containing your Git repositories
AGENT_WORKSPACE_ROOTS=/home/ubuntu

OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Oracle VPS AI Agent
